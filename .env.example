# NEXA WAF Environment Configuration
# Copy this file to .env and modify as needed

# Application
APP_NAME=NEXA WAF
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://waf:waf@localhost:5432/waf
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# WAF
WAF_MODE=enforce
DEMO_APP_URL=http://localhost:8001
REQUEST_TIMEOUT=30.0
MAX_BODY_SIZE=10485760

# Risk Thresholds
RISK_ALLOW_THRESHOLD=0.20
RISK_MONITOR_THRESHOLD=0.45
RISK_RATE_LIMIT_THRESHOLD=0.65
RISK_CHALLENGE_THRESHOLD=0.85
RISK_BLOCK_THRESHOLD=1.00

# Risk Weights
WEIGHT_TRANSFORMER=0.35
WEIGHT_ANOMALY=0.15
WEIGHT_SESSION=0.20
WEIGHT_APPLICATION=0.20
WEIGHT_RULES=0.10

# ML Model
MODEL_PATH=./ml/artifacts/model.pt
TOKENIZER_PATH=./ml/artifacts/tokenizer
MODEL_DEVICE=cpu
MAX_SEQUENCE_LENGTH=512
INFERENCE_BATCH_SIZE=32

# Session
SESSION_TTL_SECONDS=3600
SESSION_MAX_REQUESTS=1000
SESSION_CLEANUP_INTERVAL=300

# Rate Limiting
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_STORAGE=redis

# Streaming
STREAM_KEY=waf:events
STREAM_MAX_LEN=10000
SSE_HEARTBEAT_INTERVAL=15

# Batch
BATCH_MAX_FILE_SIZE=104857600
BATCH_MAX_ROWS=100000
BATCH_WORKER_CONCURRENCY=4

# Attack Lab
ATTACK_LAB_MAX_VARIANTS=100
ATTACK_LAB_TIMEOUT_SECONDS=300

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=dev-secret-change-in-production
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8001"]